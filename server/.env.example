# Подключение к PostgreSQL (docker compose up -d поднимает базу с этими параметрами)
DATABASE_URL=postgres://qadamix:qadamix_dev_password@localhost:5432/qadamix

# Секрет для подписи токенов входа. В продакшене — длинная случайная строка.
JWT_SECRET=change-me-in-production

PORT=4000

# Ключ Claude API для AI-ассистента. Без ключа ассистент работает в режиме правил.
# ANTHROPIC_API_KEY=sk-ant-...

# SMS-провайдер не подключён: в режиме разработки код входа возвращается в ответе API.
DEV_SHOW_OTP=true
